<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Mason's Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Sora:wght@400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header class="topbar">
    <nav class="nav">
        <a href="/">Home</a>
        <a href="/projects">Projects</a>
        <a href="/skills">Skills</a>
        <a href="/contact">Contact</a>
    </nav>
</header>
<main>
    @RenderBody()
</main>
<div class="footer">
    <p>Mason Doti · Last updated: October 2026</p>
</div>
</body>
</html>