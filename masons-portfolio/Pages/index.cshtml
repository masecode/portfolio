@page

@{ ViewData["Title"] = "Home"; }
@section Styles {
    <link rel="stylesheet" href="/styles/index.css">
}


<html lang="en">
<main>
    <h1 class="name">Mason Doti</h1>
    <p class="tagline">I am a Computer Systems Technology student. I build applications and run the systems they are on.</p>

    <section class="terminal">
        <div class="terminal-bar">
            <div class="terminal-line">
                <img class="terminal-minimize" src="images/minimize.svg" alt="Minimize">
                <img class="terminal-maximize" src="images/maximize.svg" alt="Maximize">
                <img class="terminal-close" src="images/close_button.svg" alt="Close">
            </div>
        </div>
        <div class="terminal-body">
            <div class="term-block">
                <div class="term-prompt">mason@portfolio ~ &gt; mason --techstack</div>
                <div class="term-output">[ "C#", "Java", "JavaScript", "Python", "Rust" ]</div>
            </div>
            <div class="term-block">
                <div class="term-prompt">mason@portfolio ~ &gt; mason --interests</div>
                <div class="term-output">[ "Snowboarding", "Homelabbing", "Programming" ]</div>
            </div>
            <div class="term-block">
                <div class="term-prompt">mason@portfolio ~ &gt; mason --education</div>
                <div class="term-output">"Computer Systems Technology - Saskatchewan Polytechnic"</div>
            </div>
            <div class="term-block">
                <div class="term-prompt">mason@portfolio ~ &gt; mason --contact-page</div>
                <div class="term-output">"<a href="/contact">Contact</a>"</div>
            </div>
        </div>
    </section>
    <section class="story-goals">
        <div class="story-para">
            <p>I have always loved computers ever since I was a little kid; learning about them and working with them has always been a passion of mine. I got to where I am today by learning both in school
                and also on my own at home. I have my own personal projects like my redeem-overlay project and homelab with local services, and I learn more about systems and applications from doing those projects.</p>
        </div>
        <br/>
        <div class="goals-para">
            <p>I aim to work as a backend developer solving a variety of problems, from low-level programming in C and Rust, to object-oriented applications in Java and C#.</p>
        </div>
    </section>
</main>
</html>
